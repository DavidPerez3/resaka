{
  "expo": {
    "name": "RESAKA",
    "slug": "resaka",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "resaka",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davidperez3.resaka"
    },
    "android": {
      "package": "com.davidperez3.resaka",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RESAKA usa tu ubicación mientras una salida está activa para dibujar el recorrido de la noche."
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/resaka"
    }
  }
}
